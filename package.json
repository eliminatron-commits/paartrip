{
  "name": "paartrip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content": "node scripts/build-content.ts",
    "assets": "node scripts/gen-assets.ts",
    "gen": "npm run content && npm run assets",
    "dev": "npm run gen && vite",
    "build": "npm run gen && vite build",
    "preview": "vite preview",
    "typecheck": "npm run content && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "test": "npm run content && vitest run",
    "test:e2e": "npm run gen && node e2e/build-versions.ts && playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-precaching": "^7.4.1",
    "zod": "^4.6.7"
  }
}
