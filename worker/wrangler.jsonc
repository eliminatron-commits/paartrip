// Cloudflare Worker "paartrip-api": Koppeln, Abgleich und Push. Läuft im Gratis-Tarif.
// Secrets stehen nicht hier: VAPID_PRIVATE_KEY wird mit `wrangler secret put` gesetzt.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "paartrip-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Keine Nutzungsdaten von Wrangler an Cloudflare.
  "send_metrics": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paartrip",
      // id der Datenbank im Cloudflare-Konto (kein Geheimnis, ohne Anmeldung nutzlos).
      "database_id": "02c9c90d-6e27-49a1-b29a-60d16e90db9d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // CORS: nur die Pages-Adresse der App.
    "ALLOWED_ORIGIN": "https://eliminatron-commits.github.io",
    "MAX_HOUSES": "20",
    // Öffentlicher VAPID-Schlüssel (darf jeder sehen). Der private dazu liegt nur als Secret bei Cloudflare.
    // Leer = Push ist aus.
    "VAPID_PUBLIC_KEY": "BGzZbOo41gzm299T_atoUmYvN7VwDDeiPmuv9o20hmxw8H83B2EsnK0kBzZJkeTvHcBxjROZuyC6BVb6XjSLu3U",
    "VAPID_SUBJECT": "https://eliminatron-commits.github.io/paartrip/",
    // Push-Dienste von Apple, Google, Mozilla und Microsoft.
    "PUSH_HOSTS": "push.apple.com,fcm.googleapis.com,push.services.mozilla.com,notify.windows.com",
    "PUSH_TEST_DELAY_MS": "5000"
    // Test-Aufgaben (Aktion test.completeTask) nimmt der Worker nur mit "TEST_ACTIONS": "1" an.
    // Im Betrieb steht die Variable nicht hier; lokal und in den Tests setzt worker/test/local-api.ts sie.
  }
}
